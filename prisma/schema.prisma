// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
    provider  = "postgresql"
    url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
    directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

generator client {
    provider = "prisma-client-js"
}

model Bet {
    id         String @id @default(uuid())
    matchId    Int    @unique
    prediction String

    // localTeam   Team? @relation("LocalBets", fields: [localTeamId], references: [id])
    localTeamId Int?

    // awayTeam   Team? @relation("AwayBets", fields: [awayTeamId], references: [id])
    awayTeamId Int?

    winner     Int? @default(0)
    betCoins   Int  @default(0)
    betProfits Int  @default(0)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // tournament   Tournament? @relation(fields: [tournamentId], references: [id])
    tournamentId Int?

    user   User   @relation(fields: [userId], references: [id])
    userId String

    statusId Int    @default(0)
    status   Status @relation(fields: [statusId], references: [id])

    Tags Tags[] @relation("SlugBets")
}

model Team {
    id          Int     @id
    abbName     String?
    fullName    String?
    country     String?
    countryName String?
    imageUrl    String?

    // localBets Bet[] @relation("LocalBets")
    // awayBets  Bet[] @relation("AwayBets")
}

model Match {
    id          Int     @id
    abbName     String?
    fullName    String?
    country     String?
    countryName String?
    imageUrl    String?

    // localBets Bet[] @relation("LocalBets")
    // awayBets  Bet[] @relation("AwayBets")
}

model Tournament {
    id         Int     @id
    name       String?
    isNational Boolean @default(false)
    // bets       Bet[]
}

model Status {
    id   Int    @id
    name String @unique
    bets Bet[]
}

model Account {
    id                 String  @id @default(uuid())
    userId             String  @map("user_id")
    type               String
    provider           String
    providerAccountId  String  @map("provider_account_id")
    refresh_token      String?
    access_token       String?
    expires_at         Int?
    token_type         String?
    scope              String?
    id_token           String?
    session_state      String?
    oauth_token_secret String?
    oauth_token        String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(uuid())
    sessionToken String   @unique @map("session_token")
    userId       String   @map("user_id")
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(uuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    password      String?
    image         String?
    coins         Int       @default(4000)
    pendingCoins  Int       @default(0)
    experience    Int       @default(0)
    level         Int       @default(0)
    createdAt     DateTime  @default(now())
    bets          Bet[]
    accounts      Account[]
    sessions      Session[]

    Tags Tags[] @relation("UserTags")
}

model VerificationToken {
    id         Int      @id @default(autoincrement())
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Tags {
    id        String   @id @default(cuid())
    name      String
    color     String?
    createdAt DateTime @default(now())
    createdBy User?    @relation("UserTags", fields: [creatorId], references: [id])
    creatorId String
    bets      Bet[]    @relation("SlugBets")

    @@index([creatorId])
}
